# ========================================================
# Handora (Desihands) - Environment Variables Skeleton
# Copy this file to '.env' and provide your actual credentials.
# DO NOT commit '.env' to version control!
# ========================================================

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-replace-with-a-random-secret-key-in-production
SITE_BASE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=127.0.0.1,localhost

# Email (SMTP / Gmail App Password)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Razorpay Payment Gateway (Test or Live)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere

# Handora Store Settings
HANDORA_UPI_ID=your-merchant-upi-id@bank
